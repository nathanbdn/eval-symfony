{% extends 'base.html.twig' %}

{% block title %}Artiste index{% endblock %}

{% block body %}
    <h1>Artiste</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Pseudonyme</th>
                <th>NomReel</th>
                <th>Bio</th>
                <th>Nationalite</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for artiste in artistes %}
            <tr>
                <td>{{ artiste.id }}</td>
                <td>{{ artiste.pseudonyme }}</td>
                <td>{{ artiste.nomReel }}</td>
                <td>{{ artiste.bio }}</td>
                <td>{{ artiste.nationalite }}</td>
                    <td>
                        <a class="btn btn-primary" href="{{ path('app_artiste_show', {'id': artiste.id}) }}">Voir</a>
                        {% if is_granted('ROLE_USER') %}
                        <a class="btn btn-warning" href="{{ path('app_artiste_edit', {'id': artiste.id}) }}">Modifier</a>

                        {% endif %}
                    </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Aucun Artiste</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if is_granted('ROLE_USER') %}
    <a class="btn btn-success" href="{{ path('app_artiste_new') }}">Ajouter</a>
    {% endif %}
{% endblock %}
